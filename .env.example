# ==============================================================================
# Plaud AI Meeting Studio - Environment Configuration
# ==============================================================================

# Required: Google Gemini API Key
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model
# Recommended options:
# - gemini-3.6-flash (Fast, highly accurate, large context window)
# - gemini-2.0-flash (High speed)
# - gemini-1.5-pro (Deep reasoning for complex multi-hour meetings)
GEMINI_MODEL=gemini-3.6-flash

# Optional: Custom Inputs / Outputs directory paths (defaults to ./inputs and ./outputs)
# INPUTS_DIR=D:\claude word\plaud AI\inputs
# OUTPUTS_DIR=D:\claude word\plaud AI\outputs
